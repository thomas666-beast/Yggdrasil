use strict;
use warnings;
use Test::More;
use Yggdrasil;

{
  package Fixtures::Invoice;
  use Moo;
  extends 'Yggdrasil::Model';
  with 'Yggdrasil::Role::SoftDeletes';
  sub table { 'ck_invoices' }
  sub timestamps { 0 }
  sub primary_key { [qw(tenant_id invoice_no)] }
  sub fillable { [qw(tenant_id invoice_no total)] }
  sub lines { shift->has_many('Line', [qw(tenant_id parent_no)]) }
  sub first_line { shift->has_one('Line', [qw(tenant_id parent_no)]) }
  sub bad_relation { shift->has_many('Line') }
  sub bad_pivot { shift->belongs_to_many('Line') }
}
{
  package Fixtures::Line;
  use Moo;
  extends 'Yggdrasil::Model';
  sub table { 'ck_lines' }
  sub timestamps { 0 }
  sub invoice { shift->belongs_to('Invoice', [qw(tenant_id parent_no)]) }
}

my @targets = (['SQLite', { driver => 'sqlite', database => ':memory:' }]);
push @targets, ['PostgreSQL', { url => $ENV{YGGDRASIL_TEST_PG} }] if $ENV{YGGDRASIL_TEST_PG};
push @targets, ['MariaDB/MySQL', { url => $ENV{YGGDRASIL_TEST_MYSQL},
  options => $ENV{YGGDRASIL_TEST_MYSQL_TLS} ? { mysql_ssl => 1 } : {} }] if $ENV{YGGDRASIL_TEST_MYSQL};

for my $target (@targets) {
  subtest $target->[0] => sub {
    my $orm = Yggdrasil->new(connections => { default => $target->[1] }, model_namespaces => ['Fixtures']);
    my $db = $orm->db;
    my $schema = $db->schema;
    $schema->drop_if_exists($_) for qw(ck_lines ck_invoices);
    $schema->create('ck_invoices', sub {
      my $t = shift;
      $t->integer($_) for qw(tenant_id invoice_no total);
      $t->primary([qw(tenant_id invoice_no)]);
      $t->soft_deletes;
    });
    $schema->create('ck_lines', sub {
      my $t = shift;
      $t->id;
      $t->integer($_)->nullable for qw(tenant_id parent_no);
      $t->string('label');
      $t->foreign([qw(tenant_id parent_no)])->references(qw(tenant_id invoice_no))->on('ck_invoices');
    });
    my $a = { tenant_id => 1, invoice_no => 7 };
    my $b = { tenant_id => 2, invoice_no => 7 };
    my $c = { tenant_id => 1, invoice_no => 8 };
    my $q = $orm->model_query('Invoice');
    my ($one, $two, $three) = map { $orm->create_model('Invoice', { %$_, total => $_->{tenant_id} * 10 }) } ($a, $b, $c);
    is_deeply $one->get_key, $a, 'model exposes the full key';
    is $q->find($b)->total, 20, 'same invoice number in a different tenant finds the right row';
    is $q->find([$a, $b])->size, 2, 'find accepts several full keys';
    is $q->find([])->size, 0, 'empty key list matches no rows';
    for my $bad (7, { tenant_id => 1 }, { %$a, unknown => 2 }, { %$a, invoice_no => undef }, { %$a, invoice_no => [7, 8] }) {
      eval { $q->find($bad) };
      like $@, qr/composite primary key columns/, 'invalid key shape fails';
    }
    eval { $orm->create_model('Invoice', {tenant_id => 1, total => 9}) };
    like $@, qr/every composite primary key/, 'insert requires all key values';
    eval { $q->delete(undef) };
    like $@, qr/composite primary key/, 'explicit undef cannot become an unfiltered delete';
    eval { $q->insert_get_id({%$a, total => 1}) };
    like $@, qr/does not support composite keys/, 'no misleading autogenerated key path';
    $one->update({total => 15})->increment('total', 3)->refresh;
    is $one->total, 18, 'update, increment and refresh use all columns';
    is $two->fresh->total, 20, 'same invoice number is unaffected';
    $one->set_attribute(invoice_no => 8);
    eval { $one->save };
    like $@, qr/cannot change the primary key/, 'stored identity cannot be redirected';
    is $q->find($c)->total, 10, 'row at attempted new key untouched';
    $one->set_attribute(invoice_no => 7);
    my $partial = $q->clone->select(qw(tenant_id total))->find($a);
    eval { $partial->delete };
    like $@, qr/requires a stored primary key/, 'partial projection cannot delete';
    is_deeply $one->replicate->get_key, { tenant_id => undef, invoice_no => undef }, 'replicate clears every key component';

    my $line = $one->lines->create({label => 'first tenant'});
    $two->lines->create({label => 'second tenant'});
    my $unbound = $orm->create_model('Line', {label => 'unassigned'});
    ok !defined $unbound->invoice->first, 'null tuple never matches a row';
    $unbound->invoice->associate($three)->save;
    is $unbound->invoice->first->invoice_no, 8, 'associate writes both foreign keys';
    is $line->invoice->first->tenant_id, 1, 'belongs_to follows the full composite foreign key';
    is $one->lines->where(label => 'absent')->or_where(label => 'second tenant')->count, 0, 'OR cannot bypass relationship keys';
    my $with = $q->clone->include('lines.invoice', 'first_line')->order_by('tenant_id')->order_by('invoice_no')->get;
    is_deeply [map { $_->related('first_line')->label } @$with], ['first tenant', 'unassigned', 'second tenant'], 'eager has_one matches both columns';
    is_deeply [map { $_->related('lines')->first->related('invoice')->get_key } @$with], [$a, $c, $b], 'nested eager loading preserves exact tuples';
    eval { $one->bad_relation };
    like $@, qr/matching foreign and local key/, 'composite relations cannot fall back to one column';
    eval { $one->bad_pivot };
    like $@, qr/matching foreign and local key/, 'composite pivots must declare all pivot columns';
    $unbound->invoice->dissociate->save;
    is $three->lines->count, 0, 'dissociate clears the tuple';

    my (@keys, @sizes);
    $db->enable_query_log;
    $q->chunk_by_cursor(sub {
      my ($rows, $page_no) = @_;
      push @sizes, scalar @$rows;
      push @keys, map { $_->get_key } @$rows;
      return 1;
    }, size => 2, order => [qw(tenant_id invoice_no)]);
    is_deeply \@sizes, [2, 1], 'export returns bounded cursor batches';
    is_deeply \@keys, [$a, $c, $b], 'duplicate invoice numbers do not skip or repeat rows';
    is scalar @{$db->query_log}, 2, 'one query per batch for the direct export';
    unlike join(' ', map { $_->{query} } @{$db->query_log}), qr/\b(offset|count)\b/i, 'export does not calculate offsets or totals';
    $db->disable_query_log;
    my $seen = 0;
    $q->chunk_by_cursor(sub { $seen++; 0 }, size => 1, order => [qw(tenant_id invoice_no)]);
    is $seen, 1, 'callback can stop after a batch';

    $q->clone->where(tenant_id => 3)->or_where(total => 18)->delete($a);
    ok !defined $q->find($a), 'query delete filters and soft-deletes by the full key';
    ok $q->find($b), 'other tenant remains visible';
    $one->fresh->restore;
    ok $q->find($a), 'restore uses both columns';
    $two->delete;
    ok !defined $q->find($b), 'instance delete soft-deletes only its row';
    $three->force_delete;
    ok !defined $three->query(with_trashed => 1)->find($c), 'force delete uses full key';
    $schema->drop_if_exists($_) for qw(ck_lines ck_invoices);
    $orm->disconnect_all;
  };
}

done_testing;
